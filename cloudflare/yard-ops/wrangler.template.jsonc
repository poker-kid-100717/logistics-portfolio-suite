{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logistics-yard-ops",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "routes": [
    { "pattern": "__YARD_HOST__", "custom_domain": true }
  ],
  "vars": {
    "LTL_BASE_URL": "https://__LTL_HOST__/"
  },
  "assets": {
    "directory": "../../../apps/yard-ops/web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/health/*"]
  },
  "containers": [
    {
      "class_name": "YardApi",
      "image": "../../../apps/yard-ops/api/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "YardApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["YardApi"] }
  ],
  "observability": { "enabled": true }
}
